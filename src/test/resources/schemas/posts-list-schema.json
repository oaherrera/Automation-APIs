{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Posts List",
  "description": "Schema de la lista de publicaciones de JSONPlaceholder",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["userId", "id", "title", "body"],
    "properties": {
      "userId": {
        "type": "integer",
        "description": "ID del usuario propietario de la publicación"
      },
      "id": {
        "type": "integer",
        "description": "ID único de la publicación"
      },
      "title": {
        "type": "string",
        "description": "Título de la publicación"
      },
      "body": {
        "type": "string",
        "description": "Contenido de la publicación"
      }
    },
    "additionalProperties": false
  }
}
