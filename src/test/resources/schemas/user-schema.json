{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "description": "Schema de un usuario de JSONPlaceholder",
  "type": "object",
  "required": ["id", "name", "username", "email"],
  "properties": {
    "id": {
      "type": "integer",
      "description": "ID único del usuario"
    },
    "name": {
      "type": "string",
      "description": "Nombre completo del usuario"
    },
    "username": {
      "type": "string",
      "description": "Nombre de usuario"
    },
    "email": {
      "type": "string",
      "description": "Correo electrónico del usuario"
    },
    "address": {
      "type": "object",
      "description": "Dirección del usuario",
      "properties": {
        "street": { "type": "string" },
        "suite":  { "type": "string" },
        "city":   { "type": "string" },
        "zipcode": { "type": "string" },
        "geo": {
          "type": "object",
          "properties": {
            "lat": { "type": "string" },
            "lng": { "type": "string" }
          }
        }
      }
    },
    "phone": {
      "type": "string",
      "description": "Número de teléfono"
    },
    "website": {
      "type": "string",
      "description": "Sitio web del usuario"
    },
    "company": {
      "type": "object",
      "description": "Empresa del usuario",
      "properties": {
        "name":        { "type": "string" },
        "catchPhrase": { "type": "string" },
        "bs":          { "type": "string" }
      }
    }
  }
}
